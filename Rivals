        Transparency = default and 0.55 or 1,
        Parent = toggleTrack,
    })

    local trail = create("Frame", {
        Name = "Trail",
        Size = UDim2.new(0, 16, 0, 16),
        Position = default and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
        BackgroundColor3 = COLORS.Accent,
        BackgroundTransparency = 1,
        ZIndex = 1,
        Parent = toggleTrack,
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = trail })

    local toggleKnob = create("Frame", {
        Name = "Knob",
        Size = UDim2.new(0, 16, 0, 16),
        Position = default and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        ZIndex = 2,
        Parent = toggleTrack,
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = toggleKnob })

    local toggleScale = create("UIScale", { Scale = 1, Parent = toggleTrack })

    local state = default

    local function updateToggle(animate)
        local onPos = UDim2.new(1, -19, 0.5, -8)
        local offPos = UDim2.new(0, 3, 0.5, -8)
        local trackGoal = { BackgroundColor3 = state and COLORS.Accent or COLORS.ToggleOff }
        local knobGoal = { Position = state and onPos or offPos }
        local ringGoal = { Transparency = state and 0.55 or 1 }

        if animate then
            TweenService:Create(toggleTrack, TweenInfo.new(0.15, Enum.EasingStyle.Quad), trackGoal):Play()
            TweenService:Create(toggleKnob, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), knobGoal):Play()
            TweenService:Create(toggleRing, TweenInfo.new(0.15), ringGoal):Play()

            trail.Position = state and offPos or onPos
            trail.Size = UDim2.new(0, 16, 0, 16)
            trail.BackgroundTransparency = 0.5
            TweenService:Create(trail, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 26, 0, 26),
                Position = UDim2.new(
                    (state and offPos or onPos).X.Scale, (state and offPos or onPos).X.Offset - 5,
                    0.5, -13
                ),
                BackgroundTransparency = 1,
            }):Play()
        else
            toggleTrack.BackgroundColor3 = trackGoal.BackgroundColor3
            toggleKnob.Position = knobGoal.Position
            toggleRing.Transparency = ringGoal.Transparency
        end
    end

    toggleTrack.MouseButton1Click:Connect(function()
        state = not state
        updateToggle(true)
        if callback then
            callback(state)
        end

        toggleScale.Scale = 0.88
        TweenService:Create(toggleScale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Scale = 1,
        }):Play()
    end)

    row.MouseEnter:Connect(function()
        TweenService:Create(row, TweenInfo.new(0.12), { BackgroundTransparency = 0.1 }):Play()
        TweenService:Create(rowStroke, TweenInfo.new(0.12), { Transparency = 0.35 }):Play()
        TweenService:Create(rowShadow, TweenInfo.new(0.12), { ImageTransparency = 0.85 }):Play()
    end)
    row.MouseLeave:Connect(function()
        TweenService:Create(row, TweenInfo.new(0.12), { BackgroundTransparency = 0.3 }):Play()
        TweenService:Create(rowStroke, TweenInfo.new(0.12), { Transparency = 0.7 }):Play()
        TweenService:Create(rowShadow, TweenInfo.new(0.12), { ImageTransparency = 1 }):Play()
    end)

    return row, function()
        return state
    end
end

