    })
    create("UICorner", { CornerRadius = UDim.new(0, 10), Parent = configButton })

    local dropdown = create("Frame", { Size = UDim2.new(0, 200, 0, 120), Position = UDim2.new(1, -210, 1, 6), BackgroundColor3 = COLORS.Row, BackgroundTransparency = 0, BorderSizePixel = 0, Visible = false, ZIndex = 5, Parent = configRow })
    create("UICorner", { CornerRadius = UDim.new(0, 10), Parent = dropdown })
    -- ensure a top-level overlay exists so the dropdown can render above other UI
    local existingOverlay = screenGui:FindFirstChild("ConfigDropdownOverlay")
    if not existingOverlay then
        existingOverlay = create("Frame", {
            Name = "ConfigDropdownOverlay",
            Size = UDim2.new(1, 0, 1, 0),
            Position = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1,
            Visible = false,
            ZIndex = 2000,
            Parent = screenGui,
        })
        -- start inactive; only become Active when visible so it doesn't capture input
        existingOverlay.Active = false
    end
    -- reparent dropdown into the overlay so it appears above other UI
    dropdown.Parent = existingOverlay
    dropdown.ZIndex = 2001
    local dropdownOverlay = existingOverlay

    local function refreshDropdown()
        for _, child in ipairs(dropdown:GetChildren()) do if child.Name ~= "UIListLayout" and child.Name ~= "UIPadding" then child:Destroy() end end
        local files = listConfigs()
        dropdown.Size = UDim2.new(0, 200, 0, math.max(1, #files) * 28)
        for i, name in ipairs(files) do
            local btn = create("TextButton", { Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 0, (i-1) * 28), BackgroundColor3 = COLORS.Row, Text = name, TextColor3 = COLORS.Text, Font = Enum.Font.Gotham, TextSize = 13, Parent = dropdown, AutoButtonColor = false })
            create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = btn })
            btn.MouseEnter:Connect(function()
                TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundTransparency = 0.2 }):Play()
            end)
            btn.MouseLeave:Connect(function()
                TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundTransparency = 0 }):Play()
            end)
            btn.MouseButton1Click:Connect(function()
                selectedConfig = name
                configButton.Text = name
                dropdown.Visible = false
            end)
        end
    end
    create("UIListLayout", { Parent = dropdown })
    create("UIPadding", { PaddingTop = UDim.new(0, 4), Parent = dropdown })

    local dropdownUpdater
    configButton.MouseButton1Click:Connect(function()
        dropdownOverlay.Visible = not dropdownOverlay.Visible
        dropdown.Visible = dropdownOverlay.Visible
        -- toggle Active only when visible so overlay doesn't capture input when hidden
        dropdownOverlay.Active = dropdownOverlay.Visible
        if dropdown.Visible then
            refreshDropdown()
            -- position dropdown under the configButton in absolute screen coords
            local pos = configButton.AbsolutePosition
            local size = configButton.AbsoluteSize
            dropdown.Position = UDim2.new(0, pos.X, 0, pos.Y + size.Y + 4)
            -- keep it positioned if UI moves (drag, resize)
            dropdownUpdater = RunService.RenderStepped:Connect(function()
                if not dropdown or not dropdown.Parent or not dropdown.Visible then
                    if dropdownUpdater then dropdownUpdater:Disconnect() dropdownUpdater = nil end
                    return
                end
                local p = configButton.AbsolutePosition
                local s = configButton.AbsoluteSize
                dropdown.Position = UDim2.new(0, p.X, 0, p.Y + s.Y + 4)
            end)
        else
            if dropdownUpdater then dropdownUpdater:Disconnect() dropdownUpdater = nil end
        end
    end)

    -- clicking anywhere on overlay (outside the dropdown) closes it
    dropdownOverlay.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if dropdown.Visible then
                dropdown.Visible = false
                dropdownOverlay.Visible = false
                if dropdownUpdater then dropdownUpdater:Disconnect() dropdownUpdater = nil end
            end
        end
    end)

    -- Name textbox row
    local nameRow = create("Frame", { Name = "NameRow", Size = UDim2.new(1, 0, 0, 48), BackgroundColor3 = COLORS.Background, BackgroundTransparency = 0.3, LayoutOrder = 2, Parent = configsBox })
    create("UICorner", { CornerRadius = UDim.new(0, 12), Parent = nameRow })
    create("UIStroke", { Color = COLORS.Border, Thickness = 1, Transparency = 0.7, Parent = nameRow })
    create("TextLabel", { Size = UDim2.new(1, -170, 0, 18), Position = UDim2.new(0, 8, 0, 8), BackgroundTransparency = 1, Text = "Name", TextColor3 = COLORS.Text, TextSize = 14, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, Parent = nameRow })
    local nameBox = create("TextBox", { Size = UDim2.new(0, 200, 0, 28), Position = UDim2.new(1, -210, 0.5, -14), BackgroundColor3 = COLORS.Row, Text = "NewConfig", TextColor3 = COLORS.Text, Font = Enum.Font.Gotham, TextSize = 14, Parent = nameRow, ClearTextOnFocus = false })
    create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = nameBox })
    -- register textbox setter for config name input
    pcall(function()
        UI_SETTERS.textboxes["Name"] = function(val)
            if type(val) ~= "string" then return end
            nameBox.Text = val
        end
    end)

    -- Buttons row
    -- swap: put buttons above the dropdown
    local btnRow = create("Frame", { Name = "ButtonsRow", Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, LayoutOrder = 2, Parent = configsBox })
    local btnRow2 = create("Frame", { Name = "ButtonsRow2", Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, LayoutOrder = 3, Parent = configsBox })
    local function makeBtn(text, order, parent)
        parent = parent or btnRow
        local b = create("TextButton", { Size = UDim2.new(0, 120, 0, 28), Position = UDim2.new(0, (order-1) * 124, 0, 0), BackgroundColor3 = COLORS.ToggleOff, Text = text, TextColor3 = COLORS.Text, Font = Enum.Font.GothamMedium, TextSize = 14, Parent = parent, AutoButtonColor = false })
        create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = b })
        return b
    end

    local saveBtn = makeBtn("Save", 1, btnRow)
    local loadBtn = makeBtn("Load", 2, btnRow)
    local overrideBtn = makeBtn("Override", 3, btnRow)
    local deleteBtn = makeBtn("Delete", 1, btnRow2)
    local autoloadBtn = makeBtn("Set Autoload", 2, btnRow2)

    saveBtn.MouseButton1Click:Connect(function()
        local name = tostring(nameBox.Text or ""):gsub("%s+", "")
        if name == "" then showNotification("Please enter a name", Color3.fromRGB(200,60,60)) return end
        local ok = saveConfig(name, gatherState())
        if ok then
            refreshDropdown()
            showNotification("Saved config: " .. name, COLORS.Accent)
        else
            showNotification("Failed to save: " .. name, Color3.fromRGB(200,60,60))
        end
    end)

    saveBtn.MouseEnter:Connect(function() TweenService:Create(saveBtn, TweenInfo.new(0.12), { BackgroundTransparency = 0.1 }):Play() end)
    saveBtn.MouseLeave:Connect(function() TweenService:Create(saveBtn, TweenInfo.new(0.12), { BackgroundTransparency = 0 }):Play() end)


    loadBtn.MouseButton1Click:Connect(function()
        if selectedConfig == "" then showNotification("No config selected", Color3.fromRGB(200,60,60)) return end
        local data = loadConfig(selectedConfig)
        if data then
            applyState(data)
            showNotification("Loaded config: " .. selectedConfig, COLORS.Accent)
        else
            showNotification("Failed to load: " .. selectedConfig, Color3.fromRGB(200,60,60))
        end
    end)
    loadBtn.MouseEnter:Connect(function() TweenService:Create(loadBtn, TweenInfo.new(0.12), { BackgroundTransparency = 0.1 }):Play() end)
    loadBtn.MouseLeave:Connect(function() TweenService:Create(loadBtn, TweenInfo.new(0.12), { BackgroundTransparency = 0 }):Play() end)

    overrideBtn.MouseButton1Click:Connect(function()
        if selectedConfig == "" then showNotification("No config selected to override", Color3.fromRGB(200,60,60)) return end
        local ok = saveConfig(selectedConfig, gatherState())
        if ok then
            refreshDropdown()
            showNotification("Overrode config: " .. selectedConfig, COLORS.Accent)
        else
            showNotification("Failed to override: " .. selectedConfig, Color3.fromRGB(200,60,60))
        end
    end)
    overrideBtn.MouseEnter:Connect(function() TweenService:Create(overrideBtn, TweenInfo.new(0.12), { BackgroundTransparency = 0.1 }):Play() end)
    overrideBtn.MouseLeave:Connect(function() TweenService:Create(overrideBtn, TweenInfo.new(0.12), { BackgroundTransparency = 0 }):Play() end)

    autoloadBtn.MouseButton1Click:Connect(function()
        if selectedConfig == "" then showNotification("No config selected to autoload", Color3.fromRGB(200,60,60)) return end
        if setAutoload(selectedConfig) then showNotification("Set autoload: " .. selectedConfig, COLORS.Accent) end
    end)
    autoloadBtn.MouseEnter:Connect(function() TweenService:Create(autoloadBtn, TweenInfo.new(0.12), { BackgroundTransparency = 0.1 }):Play() end)
    autoloadBtn.MouseLeave:Connect(function() TweenService:Create(autoloadBtn, TweenInfo.new(0.12), { BackgroundTransparency = 0 }):Play() end)

    -- Delete config button
    deleteBtn.MouseButton1Click:Connect(function()
        if selectedConfig == "" then showNotification("No config selected to delete", Color3.fromRGB(200,60,60)) return end
        local ok = false
        if type(delfile) == "function" then
            ok = pcall(delfile, configFilePath(selectedConfig))
        elseif type(deletefile) == "function" then
            ok = pcall(deletefile, configFilePath(selectedConfig))
        elseif type(writefile) == "function" and type(listfiles) ~= "function" then
            -- index-only mode: remove from index
            local idx = readIndex()
            idx[selectedConfig] = nil
            writeIndex(idx)
            ok = true
        end
        if ok then
            refreshDropdown()
            showNotification("Deleted config: " .. selectedConfig, COLORS.Accent)
            selectedConfig = ""
            configButton.Text = "Select..."
        else
            showNotification("Failed to delete: " .. selectedConfig, Color3.fromRGB(200,60,60))
        end
    end)
    deleteBtn.MouseEnter:Connect(function() TweenService:Create(deleteBtn, TweenInfo.new(0.12), { BackgroundTransparency = 0.1 }):Play() end)
    deleteBtn.MouseLeave:Connect(function() TweenService:Create(deleteBtn, TweenInfo.new(0.12), { BackgroundTransparency = 0 }):Play() end)

    -- On startup: refresh list and attempt autoload
    task.spawn(function()
        refreshDropdown()
        -- wait briefly for other UI controls and setters to be registered so applyState can use them
        local attempts = 0
        while attempts < 40 and not (next(UI_SETTERS.toggles) or next(UI_SETTERS.dropdowns) or next(UI_SETTERS.sliders)) do
            task.wait(0.05)
            attempts = attempts + 1
        end
        local auto = getAutoload()
        if auto and auto ~= "" then
            selectedConfig = auto
            configButton.Text = auto
            local data = loadConfig(auto)
            if data then applyState(data) print("Autoloaded config:", auto) end
        end
    end)
end
