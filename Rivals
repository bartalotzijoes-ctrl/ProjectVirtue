                        local topWorld = head.Position + Vector3.new(0, 0.5, 0)
                        local botWorld = root.Position - Vector3.new(0, 3, 0)
                        local topPoint, topOn = cam:WorldToViewportPoint(topWorld)
                        local botPoint, botOn = cam:WorldToViewportPoint(botWorld)
                        if topOn and botOn and topPoint.Z > 0 and botPoint.Z > 0 then
                            local top2 = Vector2.new(topPoint.X, topPoint.Y)
                            local bot2 = Vector2.new(botPoint.X, botPoint.Y)
                            local height = math.abs(top2.Y - bot2.Y)
                            local width = math.clamp(height / 2.2, 20, 200)

                            local obj = espObjects[plr.UserId]
                            if not obj then
                                obj = {}
                                local ok1, box = pcall(function() return Drawing.new("Square") end)
                                if ok1 and box then
                                    box.Filled = false
                                    box.Thickness = 2
                                    box.Color = COLORS.Accent
