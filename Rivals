-- Cool Animations support (toggle created in Fun tab)
local coolAnimationsEnabled = false
local coolAnimData = {
    animator = nil,
    idleAnim = nil,
    moveAnim = nil,
    idleTrack = nil,
    moveTrack = nil,
    conn = nil,
}

local function stopCoolAnimations()
    -- stop and clean up tracks/connection
    pcall(function()
        if coolAnimData.conn then coolAnimData.conn:Disconnect() end
    end)
    pcall(function()
        if coolAnimData.idleTrack then coolAnimData.idleTrack:Stop() end
        if coolAnimData.moveTrack then coolAnimData.moveTrack:Stop() end
    end)
    pcall(function()
        if coolAnimData.idleAnim then coolAnimData.idleAnim:Destroy() end
        if coolAnimData.moveAnim then coolAnimData.moveAnim:Destroy() end
    end)
    coolAnimData.animator = nil
    coolAnimData.idleAnim = nil
    coolAnimData.moveAnim = nil
    coolAnimData.idleTrack = nil
    coolAnimData.moveTrack = nil
    coolAnimData.conn = nil
end

local function startCoolAnimations()
    -- only while flying and character present
    local character = player.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    -- prepare animator
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end
    coolAnimData.animator = animator

    -- pick animation IDs based on R15 vs R6
    local isR15 = (character:FindFirstChild("Humanoid") and character:FindFirstChild("Humanoid").RigType == Enum.HumanoidRigType.R15)
    local idleId = isR15 and 118887989811082 or 115090652463167
    local moveId = isR15 and 127955260682615 or 86640454636089

    -- create Animation objects
    local idleAnim = Instance.new("Animation")
    idleAnim.Name = "CoolFlyIdle"
    idleAnim.AnimationId = "rbxassetid://" .. tostring(idleId)
    local moveAnim = Instance.new("Animation")
    moveAnim.Name = "CoolFlyMove"
    moveAnim.AnimationId = "rbxassetid://" .. tostring(moveId)

    coolAnimData.idleAnim = idleAnim
    coolAnimData.moveAnim = moveAnim

    -- load tracks: prefer Humanoid:LoadAnimation when available, fallback to Animator
    local ok, idleTrack, ok2, moveTrack
    -- try humanoid:LoadAnimation
    if humanoid and humanoid.LoadAnimation then
        ok, idleTrack = pcall(function() return humanoid:LoadAnimation(idleAnim) end)
        ok2, moveTrack = pcall(function() return humanoid:LoadAnimation(moveAnim) end)
    end
    -- fallback to animator:LoadAnimation if needed
    if (not ok or not idleTrack) and animator and animator.LoadAnimation then
        local okf, idleTrackF = pcall(function() return animator:LoadAnimation(idleAnim) end)
        if okf and idleTrackF then ok = okf; idleTrack = idleTrackF end
    end
    if (not ok2 or not moveTrack) and animator and animator.LoadAnimation then
        local okf2, moveTrackF = pcall(function() return animator:LoadAnimation(moveAnim) end)
        if okf2 and moveTrackF then ok2 = okf2; moveTrack = moveTrackF end
    end
    if ok and idleTrack then
        idleTrack.Looped = true
        pcall(function() idleTrack:Play() end)
        if idleTrack.AdjustSpeed then pcall(function() idleTrack:AdjustSpeed(1) end) end
        if idleTrack.AdjustWeight then pcall(function() idleTrack:AdjustWeight(1) end) end
        coolAnimData.idleTrack = idleTrack
    end
    if ok2 and moveTrack then
        moveTrack.Looped = true
        -- start stopped; will be played when movement detected
        if moveTrack.AdjustSpeed then pcall(function() moveTrack:AdjustSpeed(1) end) end
        if moveTrack.AdjustWeight then pcall(function() moveTrack:AdjustWeight(1) end) end
        coolAnimData.moveTrack = moveTrack
    end

    -- heartbeat to switch between idle and move based on velocity
    coolAnimData.conn = RunService.Heartbeat:Connect(function()
        if not flyEnabled or not coolAnimationsEnabled then
            stopCoolAnimations()
            return
        end
        local root = character:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local vel = root.Velocity
        local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
        if speed > 1 then
            if coolAnimData.idleTrack and coolAnimData.idleTrack.IsPlaying then
                pcall(function() coolAnimData.idleTrack:Stop() end)
            end
            if coolAnimData.moveTrack and not coolAnimData.moveTrack.IsPlaying then
                pcall(function() coolAnimData.moveTrack:Play() end)
            end
        else
            if coolAnimData.moveTrack and coolAnimData.moveTrack.IsPlaying then
                pcall(function() coolAnimData.moveTrack:Stop() end)
            end
            if coolAnimData.idleTrack and not coolAnimData.idleTrack.IsPlaying then
                pcall(function() coolAnimData.idleTrack:Play() end)
            end
        end
    end)
end

