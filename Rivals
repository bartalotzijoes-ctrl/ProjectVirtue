            local ok, files = pcall(listfiles, configFolder)
            if ok and files then
                for _, f in ipairs(files) do
                    local name = f:match("([^/\\]+)%.json$")
                    if name then out[name] = true end
                end
            end
        end
        -- also include any names stored in the index file
        local idx = readIndex()
        for name, _ in pairs(idx) do out[name] = true end
        local list = {}
        for name, _ in pairs(out) do table.insert(list, name) end
        table.sort(list)
        return list
    end

    local function saveConfig(name, data)
        if not name or name == "" then return false end
        local encoded = HttpService:JSONEncode(data or {})
        if type(writefile) == "function" then
            if type(listfiles) == "function" then
                ensureFolder()
                return pcall(writefile, configFilePath(name), encoded)
            else
                -- store in index
                local idx = readIndex()
                idx[name] = data or {}
                writeIndex(idx)
                return true
            end
        else
            warn("saveConfig: writefile not available in this environment")
            return false
        end
    end

