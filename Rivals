    -- Portable request helper: tries common request functions
    local function http_get(url, headers)
        local callers = {
            function()
                if _G and _G.syn and syn.request then return syn.request({ Url = url, Method = "GET", Headers = headers }) end
            end,
            function()
                if request then return request({ Url = url, Method = "GET", Headers = headers }) end
            end,
            function()
                if http and http.request then return http.request({ Url = url, Method = "GET", Headers = headers }) end
            end,
            function()
                if http_request then return http_request({ Url = url, Method = "GET", Headers = headers }) end
            end,
            function()
                -- Roblox HttpService fallback (returns string body)
                local HttpService = game:GetService("HttpService")
                local ok, res = pcall(function() return HttpService:GetAsync(url, true) end)
                if ok then return res end
            end,
        }

        for _, call in ipairs(callers) do
            local ok, res = pcall(call)
            if not ok then
                -- try next caller
            else
                if res == nil then
                    -- no result, try next
                else
                    local body, status
                    if type(res) == "string" then
                        body = res
                        status = 200
                    elseif type(res) == "table" then
                        -- common fields
                        body = res.Body or res.body or res.response or res.Response or res[1]
                        status = res.StatusCode or res.status or res.Status or res.code
                        -- some implementations return single string in res
                        if not body then
                            for k, v in pairs(res) do
                                if type(v) == "string" and #v > 0 then body = v break end
                            end
                        end
                    end
                    if body then
                        return true, body, status
                    end
                end
            end
        end
        return false, nil, nil
    end

    local function validate_hash(hash)
        if not hash then return false, "invalid hash" end
        local url = string.format("%s/rest/v1/keys?key=eq.%s&select=revoked,expires_at,username", SUPABASE_URL, hash)
        local headers = { ["apikey"] = SUPABASE_PUB, ["Authorization"] = "Bearer " .. SUPABASE_PUB }
        local ok, body = http_get(url, headers)
        if not ok then return nil, "http failure" end
        local succ, data = pcall(function() return HttpService:JSONDecode(body) end)
        if not succ then return nil, "invalid response" end
        if type(data) ~= "table" or #data == 0 then return false, "invalid key" end
        local row = data[1]
        if row.revoked then return false, "revoked" end
        if row.expires_at and row.expires_at ~= "" then
            local ok, expires = pcall(function() return DateTime.fromIsoDate(row.expires_at) end)
            if ok and expires then
                if DateTime.now().UnixTimestamp >= expires.UnixTimestamp then
                    return false, "expired"
                end
            end
        end
        return true, "ok"
    end

