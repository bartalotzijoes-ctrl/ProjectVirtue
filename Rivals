                                    txt.Size = 18
                                    txt.Font = 2
                                    txt.Color = COLORS.Accent
                                    txt.Outline = true
                                    txt.Visible = false
                                    obj.text = txt
                                end
                                -- tracer line
                                local ok3, tr = pcall(function() return Drawing.new("Line") end)
                                if ok3 and tr then
                                    tr.Thickness = 1
                                    tr.Color = COLORS.Accent
                                    tr.Visible = false
                                    obj.tracer = tr
                                end
                                espObjects[plr.UserId] = obj
                            end

                            if obj.box then
                                pcall(function()
                                    obj.box.Size = Vector2.new(width, height)
                                    obj.box.Position = Vector2.new(top2.X - width/2, top2.Y)
                                    obj.box.Visible = true
                                end)
                            end

                                if obj.text then
                                    local label = plr.Name
                                    if espShowHealth and hum then
                                        label = label .. " | HP: " .. math.floor(hum.Health)
                                    end
                                    if espShowDistance and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                                        local dist = (player.Character.HumanoidRootPart.Position - root.Position).Magnitude
                                        label = label .. " | " .. string.format("%.0f studs", dist)
                                    end
                                    pcall(function()
                                        obj.text.Text = label
                                        obj.text.Position = Vector2.new(top2.X, top2.Y - 12)
                                        obj.text.Visible = true
                                    end)
                                end

                                -- tracer update
                                if obj.tracer then
                                    if espTracers then
                                        local startPos = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y - 10)
                                        local mid = (top2 + bot2) * 0.5
                                        pcall(function()
                                            obj.tracer.From = startPos
                                            obj.tracer.To = mid
                                            obj.tracer.Color = COLORS.Accent
                                            obj.tracer.Visible = true
                                        end)
                                    else
                                        pcall(function() obj.tracer.Visible = false end)
                                    end
                                end
                        else
                            local obj = espObjects[plr.UserId]
                            if obj then
                                if obj.box then pcall(function() obj.box.Visible = false end) end
                                if obj.text then pcall(function() obj.text.Visible = false end) end
                                if obj.tracer then pcall(function() obj.tracer.Visible = false end) end
                            end
                        end
                    else
                        local obj = espObjects[plr.UserId]
                        if obj then
                            if obj.box then pcall(function() obj.box.Visible = false end) end
                            if obj.text then pcall(function() obj.text.Visible = false end) end
                            if obj.tracer then pcall(function() obj.tracer.Visible = false end) end
                        end
                    end
                end
            end
        end)

        Players.PlayerRemoving:Connect(function(plr)
            local obj = espObjects[plr.UserId]
            if obj then
                if obj.box and obj.box.Remove then pcall(function() obj.box:Remove() end) end
                if obj.text and obj.text.Remove then pcall(function() obj.text:Remove() end) end
                if obj.tracer and obj.tracer.Remove then pcall(function() obj.tracer:Remove() end) end
