local canInfiniteJump = false

-- Store connections so we can disconnect them on close
local connections = {}

-- Aimbot runtime (placed after connections declared)
do
    local DrawingAvailable = (type(Drawing) == "table" or (Drawing and type(Drawing.new) == "function"))
    local aimCircle = nil

    local lockActive = false
    local lockedPlayer = nil
    local lockedPart = nil

    local function ensureAimCircle()
        if not DrawingAvailable then return end
        if aimCircle and aimCircle.Remove then return end
        local ok, c = pcall(function() return Drawing.new("Circle") end)
        if ok and c then
            aimCircle = c
            aimCircle.Color = COLORS.Accent
            aimCircle.Filled = false
            aimCircle.Thickness = 1
            aimCircle.Transparency = 0.5
            aimCircle.Visible = false
        end
    end

    connections.aimRender = RunService.RenderStepped:Connect(function()
        if not DrawingAvailable then return end

        if not aimbotEnabled then
            if aimCircle and aimCircle.Visible then
                pcall(function() aimCircle.Visible = false end)
            end
            return
        end

        ensureAimCircle()
        if not aimCircle then return end

        local cam = workspace and workspace.CurrentCamera
        if not cam then return end

        local mousePos = UserInputService:GetMouseLocation()
        pcall(function()
            aimCircle.Position = mousePos
            aimCircle.Radius = aimbotRadius
            aimCircle.Visible = true
        end)

        -- find best target (use selected body part; prefer root part in first-person)
        local best, bestDist, bestScreenPos, bestPart
        local camPos = cam.CFrame and cam.CFrame.Position or (cam.CoordinateFrame and cam.CoordinateFrame.p)
        local localHead = player.Character and player.Character:FindFirstChild("Head")
        local firstPerson = false
        if localHead and camPos then
            firstPerson = (localHead.Position - camPos).Magnitude < 1.8
        end

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then
                local char = plr.Character
                if char then
                    local desiredName = aimbotTarget or "Head"
                    local part = char:FindFirstChild(desiredName) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("LowerTorso")
                    if part then
                        if firstPerson then
                            local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
                            if hrp then part = hrp end
                        end
                        local sp, onScreen = cam:WorldToViewportPoint(part.Position)
                        if onScreen and sp.Z > 0 then
                            local screenPos = Vector2.new(sp.X, sp.Y)
                            local dist = (screenPos - mousePos).Magnitude
                            if dist <= aimbotRadius then
                                if not best or dist < bestDist then
                                    best = plr
                                    bestDist = dist
                                    bestScreenPos = screenPos
                                    bestPart = part
                                end
                            end
                        end
                    end
                end
            end
        end

        -- check key held
        local keyHeld = false
        if aimbotBind then
            if aimbotBind.KeyCode and aimbotBind.KeyCode ~= Enum.KeyCode.Unknown then
                keyHeld = heldInputs[aimbotBind.KeyCode]
            else
                keyHeld = heldInputs[aimbotBind.UserInputType]
            end
        end

        -- lock target on initial key press; don't switch while holding
        if keyHeld and not lockActive then
            if best and bestPart then
                lockActive = true
                lockedPlayer = best
                lockedPart = bestPart
            end
        elseif not keyHeld and lockActive then
            lockActive = false
            lockedPlayer = nil
            lockedPart = nil
        end

        local useScreenPos = bestScreenPos
        -- if locked, prefer the locked part's current screen position
        if lockActive and lockedPart and lockedPart.Parent then
            local sp, onScreen = cam:WorldToViewportPoint(lockedPart.Position)
            if onScreen and sp.Z > 0 then
                useScreenPos = Vector2.new(sp.X, sp.Y)
            else
                -- locked target went offscreen or died; release lock
                lockActive = false
                lockedPlayer = nil
                lockedPart = nil
                useScreenPos = nil
            end
        end

        if useScreenPos and keyHeld then
            local current = UserInputService:GetMouseLocation()
            local dx = useScreenPos.X - current.X
            local dy = useScreenPos.Y - current.Y
            -- map smoothness (1..100) to step (0.005..0.5). Higher smoothness => smaller step (smoother)
            local smooth = aimbotSmoothness or 50
            local baseStep = math.clamp((101 - smooth) / 200, 0.005, 0.5)
            local step = baseStep
            -- In first-person prefer a more responsive step to avoid jitter from tiny mouse moves
            if firstPerson then
                step = math.max(baseStep * 1.6, 0.12)
                step = math.clamp(step, 0.02, 1)
            end
            local relx = dx * step
            local rely = dy * step
            pcall(function()
                if type(mousemoverel) == "function" then
                    mousemoverel(relx, rely)
                elseif type(mousemoveabs) == "function" then
                    mousemoveabs(current.X + relx, current.Y + rely)
                elseif type(mousemoveabsync) == "function" then
                    mousemoveabsync(current.X + relx, current.Y + rely)
                end
            end)
        end
    end)
end

