        TextColor3 = COLORS.Text,
        TextSize = 14,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = textContainer,
    })

    create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 14),
        Position = UDim2.new(0, 0, 0, 25),
        BackgroundTransparency = 1,
        Text = subText,
        TextColor3 = COLORS.SubText,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = textContainer,
    })

    local toggleTrack = create("TextButton", {
        Name = "ToggleTrack",
        Size = UDim2.new(0, 40, 0, 22),
        Position = UDim2.new(1, -46, 0.5, -11),
        BackgroundColor3 = default and COLORS.Accent or COLORS.ToggleOff,
        Text = "",
        AutoButtonColor = false,
        ClipsDescendants = false,
        Parent = row,
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = toggleTrack })
    local toggleRing = create("UIStroke", {
        Color = COLORS.Accent,
        Thickness = 1,
        Transparency = default and 0.55 or 1,
        Parent = toggleTrack,
    })

    local trail = create("Frame", {
        Name = "Trail",
        Size = UDim2.new(0, 16, 0, 16),
        Position = default and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
        BackgroundColor3 = COLORS.Accent,
        BackgroundTransparency = 1,
        ZIndex = 1,
        Parent = toggleTrack,
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = trail })

    local toggleKnob = create("Frame", {
        Name = "Knob",
        Size = UDim2.new(0, 16, 0, 16),
        Position = default and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        ZIndex = 2,
        Parent = toggleTrack,
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = toggleKnob })

    local toggleScale = create("UIScale", { Scale = 1, Parent = toggleTrack })

    local state = default

    local function updateToggle(animate)
        local onPos = UDim2.new(1, -19, 0.5, -8)
        local offPos = UDim2.new(0, 3, 0.5, -8)
        local trackGoal = { BackgroundColor3 = state and COLORS.Accent or COLORS.ToggleOff }
        local knobGoal = { Position = state and onPos or offPos }
        local ringGoal = { Transparency = state and 0.55 or 1 }

        if animate then
            TweenService:Create(toggleTrack, TweenInfo.new(0.15, Enum.EasingStyle.Quad), trackGoal):Play()
            TweenService:Create(toggleKnob, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), knobGoal):Play()
            TweenService:Create(toggleRing, TweenInfo.new(0.15), ringGoal):Play()

            trail.Position = state and offPos or onPos
            trail.Size = UDim2.new(0, 16, 0, 16)
            trail.BackgroundTransparency = 0.5
            TweenService:Create(trail, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 26, 0, 26),
                Position = UDim2.new(
                    (state and offPos or onPos).X.Scale, (state and offPos or onPos).X.Offset - 5,
                    0.5, -13
                ),
                BackgroundTransparency = 1,
            }):Play()
        else
            toggleTrack.BackgroundColor3 = trackGoal.BackgroundColor3
            toggleKnob.Position = knobGoal.Position
            toggleRing.Transparency = ringGoal.Transparency
        end
    end

    toggleTrack.MouseButton1Click:Connect(function()
        state = not state
        updateToggle(true)
        if callback then
            callback(state)
        end

        toggleScale.Scale = 0.88
        TweenService:Create(toggleScale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Scale = 1,
        }):Play()
    end)

    row.MouseEnter:Connect(function()
        TweenService:Create(row, TweenInfo.new(0.12), { BackgroundTransparency = 0.1 }):Play()
        TweenService:Create(rowStroke, TweenInfo.new(0.12), { Transparency = 0.35 }):Play()
        TweenService:Create(rowShadow, TweenInfo.new(0.12), { ImageTransparency = 0.85 }):Play()
    end)
    row.MouseLeave:Connect(function()
        TweenService:Create(row, TweenInfo.new(0.12), { BackgroundTransparency = 0.3 }):Play()
        TweenService:Create(rowStroke, TweenInfo.new(0.12), { Transparency = 0.7 }):Play()
        TweenService:Create(rowShadow, TweenInfo.new(0.12), { ImageTransparency = 1 }):Play()
    end)

    return row, function()
        return state
    end
end

-- ===== SLIDER ROW =====
-- Similar to toggle row but with a draggable slider that ranges from 0-500
local function createSliderRow(parentBox, labelText, minValue, maxValue, default, order, callback)
    local row = create("Frame", {
        Name = labelText .. "SliderRow",
        Size = UDim2.new(1, 0, 0, 68),
        BackgroundColor3 = COLORS.Background,
        BackgroundTransparency = 0.3,
        LayoutOrder = order,
        Parent = parentBox,
    })
    create("UICorner", { CornerRadius = UDim.new(0, 12), Parent = row })
    local rowStroke = create("UIStroke", {
        Color = COLORS.Border,
        Thickness = 1,
        Transparency = 0.7,
        Parent = row,
    })

    local rowShadow = create("ImageLabel", {
        Name = "RowShadow",
        BackgroundTransparency = 1,
        Image = "rbxassetid://6014261993",
        ImageColor3 = Color3.fromRGB(0, 0, 0),
        ImageTransparency = 1,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(49, 49, 450, 450),
        Size = UDim2.new(1, 16, 1, 16),
        Position = UDim2.new(0.5, 0, 0.5, 4),
        AnchorPoint = Vector2.new(0.5, 0.5),
        ZIndex = -1,
        Parent = row,
    })

    create("TextLabel", {
        Size = UDim2.new(1, -80, 0, 18),
        Position = UDim2.new(0, 8, 0, 8),
        BackgroundTransparency = 1,
        Text = labelText,
        TextColor3 = COLORS.Text,
        TextSize = 14,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })

    local valueLabel = create("TextLabel", {
        Size = UDim2.new(0, 70, 0, 18),
        Position = UDim2.new(1, -78, 0, 8),
        BackgroundTransparency = 1,
        Text = tostring(default),
        TextColor3 = COLORS.Accent,
        TextSize = 14,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = row,
    })

    local sliderTrack = create("Frame", {
        Name = "SliderTrack",
        Size = UDim2.new(1, -16, 0, 6),
        Position = UDim2.new(0, 8, 0, 36),
        BackgroundColor3 = COLORS.ToggleOff,
        BackgroundTransparency = 0.4,
        Parent = row,
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = sliderTrack })

    local sliderFill = create("Frame", {
        Name = "SliderFill",
        Size = UDim2.new(0, 0, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = COLORS.Accent,
        Parent = sliderTrack,
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = sliderFill })

    local sliderKnob = create("TextButton", {
        Name = "SliderKnob",
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(0, -9, 0.5, -9),
        BackgroundColor3 = COLORS.Accent,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 2,
        Parent = sliderTrack,
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = sliderKnob })
    local knobStroke = create("UIStroke", {
        Color = COLORS.AccentDim,
        Thickness = 1,
        Transparency = 0.3,
        Parent = sliderKnob,
    })

    local state = default
    local dragging = false

    local function updateSlider(newValue)
        newValue = math.clamp(newValue, minValue, maxValue)
        state = newValue
        local percentage = (newValue - minValue) / (maxValue - minValue)
        -- Display "Default" when value is 0, otherwise show the number
        if newValue == 0 then
            valueLabel.Text = "Default"
        else
            valueLabel.Text = tostring(math.floor(newValue))
        end
        sliderFill.Size = UDim2.new(percentage, 0, 1, 0)
        sliderKnob.Position = UDim2.new(percentage, -9, 0.5, -9)
        if callback then
            callback(state)
        end
    end

    sliderKnob.MouseButton1Down:Connect(function()
        dragging = true
    end)

    UserInputService.InputEnded:Connect(function()
        dragging = false
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local mousePos = UserInputService:GetMouseLocation() - GuiService:GetGuiInset()
            local trackPos = sliderTrack.AbsolutePosition.X
            local trackSize = sliderTrack.AbsoluteSize.X
            local relativePos = math.clamp(mousePos.X - trackPos, 0, trackSize)
            local percentage = relativePos / trackSize
            local newValue = minValue + (percentage * (maxValue - minValue))
            updateSlider(newValue)
        end
    end)

    sliderTrack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            local mousePos = UserInputService:GetMouseLocation() - GuiService:GetGuiInset()
            local trackPos = sliderTrack.AbsolutePosition.X
            local trackSize = sliderTrack.AbsoluteSize.X
            local relativePos = math.clamp(mousePos.X - trackPos, 0, trackSize)
            local percentage = relativePos / trackSize
            local newValue = minValue + (percentage * (maxValue - minValue))
            updateSlider(newValue)
        end
    end)

    row.MouseEnter:Connect(function()
        TweenService:Create(row, TweenInfo.new(0.12), { BackgroundTransparency = 0.1 }):Play()
        TweenService:Create(rowStroke, TweenInfo.new(0.12), { Transparency = 0.35 }):Play()
        TweenService:Create(rowShadow, TweenInfo.new(0.12), { ImageTransparency = 0.85 }):Play()
    end)
    row.MouseLeave:Connect(function()
        TweenService:Create(row, TweenInfo.new(0.12), { BackgroundTransparency = 0.3 }):Play()
        TweenService:Create(rowStroke, TweenInfo.new(0.12), { Transparency = 0.7 }):Play()
        TweenService:Create(rowShadow, TweenInfo.new(0.12), { ImageTransparency = 1 }):Play()
    end)

    return row, function()
        return state
    end
end

