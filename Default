    })
    create("UICorner", { CornerRadius = UDim.new(0, 10), Parent = tabButton })
    local tabGlow = create("UIStroke", {
        Color = COLORS.Accent,
        Thickness = 1,
        Transparency = 1,
        Parent = tabButton,
    })

    local tabLabel = create("TextLabel", {
        Name = "Label",
        Size = UDim2.new(1, -28, 1, 0),
        Position = UDim2.new(0, 16, 0, 0),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = COLORS.TabInactive,
        TextSize = 13,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = tabButton,
    })

    local indicator = create("Frame", {
        Name = "Indicator",
        Size = UDim2.new(0, 3, 0, 16),
        Position = UDim2.new(0, -10, 0.5, -8),
        BackgroundColor3 = COLORS.Accent,
        BackgroundTransparency = 1,
        Parent = tabButton,
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = indicator })

    local page = create("ScrollingFrame", {
        Name = name .. "Page",
        Size = UDim2.new(1, -32, 1, -16),
        Position = UDim2.new(0, 16, 0, 8),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = COLORS.Border,
        ScrollBarImageTransparency = 0,
        VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
        Visible = false,
        Parent = contentArea,
    })
    create("UIListLayout", {
        Padding = UDim.new(0, 12),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = page,
    })
    create("UIPadding", { PaddingBottom = UDim.new(0, 8), Parent = page })

    page.MouseEnter:Connect(function()
        TweenService:Create(page, TweenInfo.new(0.15), { ScrollBarImageColor3 = COLORS.Accent }):Play()
    end)
    page.MouseLeave:Connect(function()
        TweenService:Create(page, TweenInfo.new(0.15), { ScrollBarImageColor3 = COLORS.Border }):Play()
    end)

    local fadeTop = create("Frame", {
        Name = "FadeTop",
        Size = UDim2.new(1, 0, 0, 18),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = COLORS.Background,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 5,
        Parent = page.Parent,
    })
    create("UIGradient", {
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(1, 1),
        }),
        Rotation = 90,
        Parent = fadeTop,
    })
    local fadeBottom = create("Frame", {
        Name = "FadeBottom",
        Size = UDim2.new(1, 0, 0, 18),
        Position = UDim2.new(0, 0, 1, -18),
        BackgroundColor3 = COLORS.Background,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 5,
        Parent = page.Parent,
    })
    create("UIGradient", {
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(1, 0),
        }),
        Rotation = 90,
        Parent = fadeBottom,
    })

    local function updateFades()
        local overflow = page.AbsoluteCanvasSize.Y > page.AbsoluteWindowSize.Y + 1
        local atTop = page.CanvasPosition.Y <= 1
        local atBottom = page.CanvasPosition.Y >= (page.AbsoluteCanvasSize.Y - page.AbsoluteWindowSize.Y - 1)

        TweenService:Create(fadeTop, TweenInfo.new(0.12), {
            BackgroundTransparency = (overflow and not atTop) and 0.55 or 1,
        }):Play()
        TweenService:Create(fadeBottom, TweenInfo.new(0.12), {
            BackgroundTransparency = (overflow and not atBottom) and 0.55 or 1,
        }):Play()
    end

    page:GetPropertyChangedSignal("CanvasPosition"):Connect(updateFades)
    page:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(updateFades)
    page:GetPropertyChangedSignal("Visible"):Connect(function()
        if page.Visible then
            task.wait()
            updateFades()
        end
    end)

    tabButton.MouseButton1Click:Connect(function()
        selectTab(name)
    end)

    tabButton.MouseEnter:Connect(function()
        if activeTab ~= name then
            TweenService:Create(tabButton, TweenInfo.new(0.12), { BackgroundTransparency = 0.92 }):Play()
        end
    end)
    tabButton.MouseLeave:Connect(function()
        if activeTab ~= name then
            TweenService:Create(tabButton, TweenInfo.new(0.12), { BackgroundTransparency = 1 }):Play()
        end
    end)

    tabs[name] = { button = tabButton, page = page, indicator = indicator, label = tabLabel, glow = tabGlow, glowPulseThread = false }
    return page
end

