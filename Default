-- ===== TAB + PAGE SYSTEM =====
local tabs = {}
local activeTab = nil

local function selectTab(tabName)
    if activeTab == tabName then return end
    local previousTab = activeTab
    activeTab = tabName
    for name, entry in pairs(tabs) do
        local isActive = (name == tabName)

        if isActive then
            entry.page.Visible = true
            local restingPos = UDim2.new(0, 16, 0, 8)
            entry.page.Position = restingPos + UDim2.new(0, 0, 0, 8)
            TweenService:Create(entry.page, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Position = restingPos,
            }):Play()
        elseif name == previousTab then
            entry.page.Visible = false
        end

        TweenService:Create(entry.label, TweenInfo.new(0.15), {
            TextColor3 = isActive and COLORS.Text or COLORS.TabInactive,
        }):Play()
        TweenService:Create(entry.indicator, TweenInfo.new(0.15), {
            BackgroundTransparency = isActive and 0 or 1,
        }):Play()
        TweenService:Create(entry.button, TweenInfo.new(0.15), {
            BackgroundTransparency = isActive and 0.85 or 1,
        }):Play()

        if entry.glowPulseThread then
            entry.glowPulseThread = false
        end
        if isActive then
            TweenService:Create(entry.glow, TweenInfo.new(0.15), { Transparency = 0.65 }):Play()
            local myThreadId = {}
            entry.glowPulseThread = myThreadId
            task.spawn(function()
                task.wait(0.15)
                while entry.glowPulseThread == myThreadId do
                    local t1 = TweenService:Create(entry.glow, TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Transparency = 0.35 })
                    t1:Play()
                    t1.Completed:Wait()
                    if entry.glowPulseThread ~= myThreadId then break end
                    local t2 = TweenService:Create(entry.glow, TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Transparency = 0.7 })
                    t2:Play()
                    t2.Completed:Wait()
                end
            end)
        else
            TweenService:Create(entry.glow, TweenInfo.new(0.15), { Transparency = 1 }):Play()
        end
    end
end

local function createTab(name, order)
