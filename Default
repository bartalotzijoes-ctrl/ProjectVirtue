-- Replaces the old "section label + flat list of rows" pattern. Each box
-- is its own bordered container (title + description at the top) that
-- holds its toggle rows, so a tab can have multiple distinct boxes instead
-- of just text dividers between rows.
local function createSettingsBox(parentPage, titleText, order)
    local box = create("Frame", {
        Name = titleText .. "Box",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = COLORS.Row,
        BackgroundTransparency = 0.35,
        LayoutOrder = order,
        Parent = parentPage,
    })
    create("UICorner", { CornerRadius = UDim.new(0, 16), Parent = box })
    create("UIStroke", {
        Color = COLORS.Border,
        Thickness = 1,
        Transparency = 0.5,
        Parent = box,
    })

    local boxLayout = create("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = box,
