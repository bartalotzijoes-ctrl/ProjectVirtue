local cursorGlow = create("ImageLabel", {
    Name = "CursorGlow",
    BackgroundTransparency = 1,
    Image = "rbxassetid://9055001042",
    ImageColor3 = Color3.fromRGB(210, 208, 218),
    ImageTransparency = 1,
    ScaleType = Enum.ScaleType.Stretch,
    Size = UDim2.new(0, 150, 0, 150),
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.new(0.5, 0, 0.5, 0),
    ZIndex = 1,
    Parent = lightLayer,
})

do
    local currentPos
    local visible = false
    local connection
    connection = RunService.RenderStepped:Connect(function(dt)
        if not mainFrame.Parent or not mainFrame.Visible then
            return
        end

        local mousePos = UserInputService:GetMouseLocation() - GuiService:GetGuiInset()
        local topLeft = mainFrame.AbsolutePosition
        local size = mainFrame.AbsoluteSize
        local localX = mousePos.X - topLeft.X
        local localY = mousePos.Y - topLeft.Y
        local inside = localX >= 0 and localX <= size.X and localY >= 0 and localY <= size.Y

        local target = Vector2.new(localX, localY)
        currentPos = currentPos and currentPos:Lerp(target, 1 - math.exp(-dt * 14)) or target
        cursorGlow.Position = UDim2.new(0, currentPos.X, 0, currentPos.Y)

        if inside ~= visible then
            visible = inside
            TweenService:Create(cursorGlow, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
                ImageTransparency = visible and 0.9 or 1,
            }):Play()
        end
    end)

    mainFrame.Destroying:Connect(function()
        connection:Disconnect()
    end)
end

