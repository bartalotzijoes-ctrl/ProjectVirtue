        Position = UDim2.new(0.5, 0, 0.5, 4),
        AnchorPoint = Vector2.new(0.5, 0.5),
        ZIndex = -1,
        Parent = row,
    })

    local textContainer = create("Frame", {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.new(0, 8, 0, 0),
        BackgroundTransparency = 1,
        Parent = row,
